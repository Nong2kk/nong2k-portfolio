# Copy this file to client/.env and fill in real values.
# Vite's root is client/, so this is where it looks for .env files.
# These are public, browser-side values (they end up in the built JS).

# EmailJS (https://dashboard.emailjs.com)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google reCAPTCHA v2 "I'm not a robot" checkbox - site key only (https://www.google.com/recaptcha/admin)
VITE_RECAPTCHA_SITE_KEY=
